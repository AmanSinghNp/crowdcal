.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
# local dataset caches / checkpoints
data/cache/
data/checkpoints/**
!data/checkpoints/*/
!data/checkpoints/*/train_meta.json
# synthetic run outputs (real raw files ARE committed after the main run)
data/raw/_synthetic/
build/
# raw cache files are committed only once frozen (crowdcal freeze -> .jsonl.gz)
data/raw/**/*.jsonl

# drafts (write-up, posts) stay local
writeup/
